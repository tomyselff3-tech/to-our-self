# PostgreSQL
DATABASE_URL=postgresql://to_our_self:password@localhost:5432/to_our_self_db

# Redis
REDIS_URL=redis://localhost:6379

# Telegram Bot
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_HERE
TELEGRAM_BOT_API_URL=https://api.telegram.org

# Mini App
MINIAPP_DOMAIN=localhost:5173
MINIAPP_API_URL=http://localhost:3000/api

# API Server
API_HOST=0.0.0.0
API_PORT=3000
API_LOG_LEVEL=info

# Security
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
NODE_ENV=development

# Feature Flags
FEATURE_PAYMENTS_ENABLED=false
FEATURE_CLANS_ENABLED=false
FEATURE_TOURNAMENTS_ENABLED=false
FEATURE_SEASONS_ENABLED=false

# Admin
ADMIN_SECRET=your-admin-secret-key
